# Database
DATABASE_URL=postgresql://user:password@host:5432/carrojusto

# Gemini (LLM recommendations + ad analysis narratives)
GEMINI_API_KEY=AIza...
# LLM_MODEL=gemini-2.5-flash-preview-05-20
# LLM_MAX_RETRIES=2

# Email (Resend — https://resend.com)
RESEND_API_KEY=re_...
OPERATOR_EMAIL=team@caractr.pt

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://caractr.pt,https://www.caractr.pt

# Admin — token for /api/admin/refresh-market (generate a strong random string)
ADMIN_TOKEN=your-strong-random-token-here

# Analysis engine — set to "true" to use rule-based fallback instead of Claude API
# USE_RULE_ANALYSIS=false

# Proxy — number of trusted reverse proxy hops in front of the API
# Set to 1 when behind Railway/Render/Fly.io (they add one hop)
# Required for correct IP-based rate limiting; leave at 0 for local dev
TRUSTED_PROXY_COUNT=1

# Rate limiting — requests per minute per IP (defaults shown)
# RATE_LIMIT_LLM=10
# RATE_LIMIT_CONCIERGE=5
# RATE_LIMIT_GLOBAL=60
